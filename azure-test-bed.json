{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "CloudPilot Multi-Cloud Test Bed Generator",
      "version": "2.0.0"
    },
    "description": "CloudPilot Azure Student Test Bed. Deploys controlled cost and security misconfigurations (Open SSH/RDP NSG, Unattached Managed Disk, Idle Public IP, Public Storage Account) for live discovery and automated Safety Passport remediation."
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the test bed resources (defaults to resource group location, e.g., eastus, centralindia)."
      }
    },
    "environmentTag": {
      "type": "string",
      "defaultValue": "CloudPilot-TestBed",
      "metadata": {
        "description": "Tag used to identify test bed resources."
      }
    }
  },
  "variables": {
    "nsgName": "nsg-cloudpilot-student",
    "diskName": "disk-cloudpilot-unattached",
    "pipName": "pip-cloudpilot-idle",
    "storageAccountName": "[take(concat('cptest', uniqueString(resourceGroup().id)), 24)]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/networkSecurityGroups",
      "apiVersion": "2023-09-01",
      "name": "[variables('nsgName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Environment": "[parameters('environmentTag')]",
        "ManagedBy": "CloudPilot-TestBed"
      },
      "properties": {
        "securityRules": [
          {
            "name": "Allow-SSH-Internet-Insecure",
            "properties": {
              "description": "INTENTIONAL TEST FINDING (AZ-SEC-NSG-001): Inbound SSH open to 0.0.0.0/0",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "22",
              "sourceAddressPrefix": "*",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 1001,
              "direction": "Inbound"
            }
          },
          {
            "name": "Allow-RDP-Internet-Insecure",
            "properties": {
              "description": "INTENTIONAL TEST FINDING (AZ-SEC-NSG-002): Inbound RDP open to 0.0.0.0/0",
              "protocol": "Tcp",
              "sourcePortRange": "*",
              "destinationPortRange": "3389",
              "sourceAddressPrefix": "Internet",
              "destinationAddressPrefix": "*",
              "access": "Allow",
              "priority": 1002,
              "direction": "Inbound"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Compute/disks",
      "apiVersion": "2023-04-02",
      "name": "[variables('diskName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Environment": "[parameters('environmentTag')]",
        "ManagedBy": "CloudPilot-TestBed"
      },
      "sku": {
        "name": "Standard_LRS"
      },
      "properties": {
        "creationData": {
          "createOption": "Empty"
        },
        "diskSizeGB": 32
      }
    },
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-09-01",
      "name": "[variables('pipName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Environment": "[parameters('environmentTag')]",
        "ManagedBy": "CloudPilot-TestBed"
      },
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "publicIPAllocationMethod": "Static"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageAccountName')]",
      "location": "[parameters('location')]",
      "tags": {
        "Environment": "[parameters('environmentTag')]",
        "ManagedBy": "CloudPilot-TestBed"
      },
      "sku": {
        "name": "Standard_LRS"
      },
      "kind": "StorageV2",
      "properties": {
        "allowBlobPublicAccess": true,
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true
      }
    }
  ],
  "outputs": {
    "resourceGroupName": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "nsgId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/networkSecurityGroups', variables('nsgName'))]"
    },
    "diskId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Compute/disks', variables('diskName'))]"
    },
    "pipId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/publicIPAddresses', variables('pipName'))]"
    },
    "storageAccountId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
    }
  }
}
