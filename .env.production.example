# CloudPilot Production Environment Variables Template
# Copy this file to .env.production and supply real secrets.
# NEVER commit .env or secrets to version control!

# ── Environment & Application ──────────────────────────────────────────────────
CLOUDPILOT_ENV=production
PORT=8000
HOST=0.0.0.0

# ── Authentication & Security ──────────────────────────────────────────────────
# REQUIRED in production: High-entropy secret key (min 32 characters) used to sign HMAC tokens.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUDPILOT_AUTH_SECRET=REPLACE_WITH_HIGH_ENTROPY_HMAC_SECRET_AT_LEAST_32_CHARS_LONG
TOKEN_EXPIRY_HOURS=24

# ── AWS Operator Identity ──────────────────────────────────────────────────────
# The dedicated AWS account and IAM Role that CloudPilot runs as to assume customer roles.
AWS_DEFAULT_REGION=ap-south-1
OPERATOR_ACCOUNT_ID=123456789012
OPERATOR_ROLE_ARN=arn:aws:iam::123456789012:role/CloudPilotOperatorRole

# ── Database & Storage ─────────────────────────────────────────────────────────
CLOUDPILOT_DB_PATH=/app/data/cloudpilot.db
